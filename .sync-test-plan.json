{
 "checks": [
  {
   "name": "final image stage sets the OCI source label",
   "cmd": "tac /workspace/Dockerfile | sed '/^FROM /q' | grep -qxF 'LABEL org.opencontainers.image.source=\"https://github.com/mozilla-services/syncstorage-rs\"'"
  },
  {
   "name": "the label is set once, and only in the final stage",
   "cmd": "test \"$(grep -c 'org.opencontainers.image.source' /workspace/Dockerfile)\" = 1 && awk '/^FROM /{n++} /org.opencontainers.image.source/{print n}' /workspace/Dockerfile | grep -qx \"$(grep -c '^FROM ' /workspace/Dockerfile)\""
  }
 ]
}